{
  "agent": "claude",
  "permissions": {
    "allow": [
      "Bash(coop legacy config *)",
      "Bash(coop legacy status)",
      "Bash(coop legacy start)",
      "Bash(coop legacy stop)",
      "Bash(coop legacy reset *)",
      "Bash(coop legacy list *)",
      "Bash(coop-provision *)",
      "Bash(mkdir *)",
      "Bash(mktemp)",
      "Bash(mktemp *)",
      "Bash(openssl rand *)",
      "Bash(rm *)",
      "Bash(ls *)",
      "Bash(date *)",
      "Read(~/.agentcoop/agents/**)",
      "Edit(~/.agentcoop/agents/**)",
      "Read(~/.agentcoop/install_meta.json)"
    ],
    "deny": [
      "Read(~/.agentcoop/config.yaml)",
      "Read(~/.agentcoop/admin-profiles.yaml)",
      "Read(~/.agentcoop/.config-backups/**)",
      "Read(~/.agentcoop/agents/.bot-password.*)"
    ]
  }
}

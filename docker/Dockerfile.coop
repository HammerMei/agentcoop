# =============================================================================
# INTERNAL TESTING ONLY — built for AgentCoop's E2E/CI runs, not a supported production install (see docker/README.md).
# AgentCoop — AgentCoop Docker Image
#
# Includes: Python 3.12, uv, Claude Code (npm), OpenCode, AgentCoop installed
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.coop -t coop:latest .
#
# Run:
#   docker run -e RC_URL=... -e RC_USERNAME=... -e RC_PASSWORD=... \
#              -e COOP_OWNER_USERS=alice \
#              -e ANTHROPIC_API_KEY=sk-ant-... \
#              coop:latest
# =============================================================================

# Agent version build args — pass at build time to pin specific versions.
# Defaults to "latest" for both agents (used by e2e-canary).
# e2e-pinned passes explicit versions to ensure reproducible test runs.
ARG CLAUDE_CODE_VERSION=latest
ARG OPENCODE_VERSION=latest

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Tell Claude Code it's running in a sandboxed/container environment.
# This disables interactive permission prompts and may bypass features
# that require direct Anthropic API (e.g. context-management-2025-06-27),
# allowing OpenRouter or other compatible providers to work.
ENV IS_SANDBOX=1

# -----------------------------------------------------------------------------
# System dependencies
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Node.js 20 LTS — required for Claude Code
# -----------------------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# uv — Python package manager (also installs Python 3.12 if system lacks it)
# -----------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:/root/.cargo/bin:/root/.opencode/bin:$PATH"

# -----------------------------------------------------------------------------
# Claude Code CLI
# -----------------------------------------------------------------------------
# Re-declare ARG after FROM so it is visible in this build stage.
ARG CLAUDE_CODE_VERSION=latest
RUN if [ "$CLAUDE_CODE_VERSION" = "latest" ]; then \
      npm install -g @anthropic-ai/claude-code; \
    else \
      npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}; \
    fi

# -----------------------------------------------------------------------------
# OpenCode CLI
# -----------------------------------------------------------------------------
ARG OPENCODE_VERSION=latest
RUN if [ "$OPENCODE_VERSION" = "latest" ]; then \
      curl -fsSL https://opencode.ai/install | bash; \
    else \
      curl -fsSL https://opencode.ai/install | bash -s -- --version ${OPENCODE_VERSION}; \
    fi

# -----------------------------------------------------------------------------
# Install AgentCoop — mirrors the real curl | bash install flow exactly:
#   repo → ~/.agentcoop/repo  (same as curl | bash)
#
# Benefits:
#   1. install_meta.json points to ~/.agentcoop/repo — upgrade works
#   2. Docker build validates install.sh in the same path as real installs
#   3. `coop upgrade` can be run inside the container
# -----------------------------------------------------------------------------
COPY . /root/.agentcoop/repo
RUN bash /root/.agentcoop/repo/install.sh --no-onboard

# -----------------------------------------------------------------------------
# Pre-create all mountable directories
#
# Volume mount points:
#
#   ~/.agentcoop/config/   — ONLY config.yaml + .env (safe to bind-mount;
#                                      entrypoint symlinks them one level up)
#   ~/.agentcoop/work/      — agent working directory (inspectable locally)
#   ~/.agentcoop/contexts/  — custom context files (defaults restored if empty)
#   ~/.claude/                       — Claude Code config & auth (settings.json, CLAUDE.md)
#   ~/.config/opencode/              — OpenCode config & API key (config.json)
#
# NOTE: do NOT bind-mount ~/.agentcoop directly — it contains
# install_meta.json and contexts required at runtime.
# -----------------------------------------------------------------------------
RUN mkdir -p \
    /root/.agentcoop/config \
    /root/.agentcoop/work \
    /root/.agentcoop/logs \
    /root/.agentcoop/data \
    /root/.claude \
    /root/.config/opencode

# -----------------------------------------------------------------------------
# Entrypoint — generates config.yaml + .env from env vars, starts daemon
# -----------------------------------------------------------------------------
COPY docker/entrypoint.coop.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
